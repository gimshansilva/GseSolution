{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Gse.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Gse.Api/bin/Debug/net8.0/Gse.Api.dll",
      "cwd": "${workspaceFolder}/Gse.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7001;http://localhost:5001"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}
