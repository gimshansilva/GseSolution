{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "gse-api",
    "Audience": "gse-clients",
    "AccessTokenMinutes": 15
  },
  "Cors": {
    "Origins": [ "https://localhost:5173" ]
  },
  "RateLimit": {
    "Api": { "PermitLimit": 100 },
    "Login": { "PermitLimit": 5 }
  },
  "AllowedHosts": "localhost"
}
